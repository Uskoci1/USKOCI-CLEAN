{
  "schema": 1,
  "purpose": "One table, read by two languages. The Python proof classifies every provider redirect it sees with s03_core.classify_callback; the app decides what a native recovery callback may do with parseRecoveryCallback (src/data/passwordRecoveryLink.ts). test_s03_core.py checks the py* columns, src/data/__tests__/ex07-auth-callback-routing.test.ts checks the appRecoveryParse column against the REAL app parser, so the harness and the app cannot drift apart silently. All tokens are synthetic (no real credential, no JWT lookalike).",
  "redirects": {
    "signup": "uskociapp://auth?form=login",
    "recovery": "uskociapp://oporavak"
  },
  "cases": [
    {
      "id": "signup-session-tokens",
      "why": "What GoTrue's implicit flow returns after a signup confirmation (tokens in the fragment, type=signup). The app must open the login form and adopt nothing.",
      "url": "uskociapp://auth?form=login#access_token=SYNTHACCESSSIGNUP0001&expires_at=1893456000&expires_in=3600&refresh_token=SYNTHREFRESHSIGNUP1&token_type=bearer&type=signup",
      "expectedBase": "signup",
      "pyKind": "SESSION_TOKENS", "pyType": "signup", "pyBaseMatches": true, "pyTokensInQuery": false,
      "appRecoveryParse": "INVALID_LINK"
    },
    {
      "id": "recovery-session-tokens",
      "why": "What GoTrue returns after a recovery link (tokens in the fragment, type=recovery): the only shape the recovery screen accepts.",
      "url": "uskociapp://oporavak#access_token=SYNTHACCESSRECOVERY01&expires_at=1893456000&expires_in=3600&refresh_token=SYNTHREFRESHRECOVER1&token_type=bearer&type=recovery",
      "expectedBase": "recovery",
      "pyKind": "SESSION_TOKENS", "pyType": "recovery", "pyBaseMatches": true, "pyTokensInQuery": false,
      "appRecoveryParse": "ACCEPTED"
    },
    {
      "id": "signup-tokens-at-recovery-host",
      "why": "Signup tokens must never become password-recovery authority, even if they reach the recovery host.",
      "url": "uskociapp://oporavak#access_token=SYNTHACCESSSIGNUP0002&refresh_token=SYNTHREFRESHSIGNUP2&token_type=bearer&type=signup",
      "expectedBase": "recovery",
      "pyKind": "SESSION_TOKENS", "pyType": "signup", "pyBaseMatches": true, "pyTokensInQuery": false,
      "appRecoveryParse": "INVALID_LINK"
    },
    {
      "id": "recovery-tokens-at-signup-destination",
      "why": "A recovery callback delivered to the signup destination is not a recovery callback.",
      "url": "uskociapp://auth?form=login#access_token=SYNTHACCESSRECOVERY02&refresh_token=SYNTHREFRESHRECOVER2&token_type=bearer&type=recovery",
      "expectedBase": "signup",
      "pyKind": "SESSION_TOKENS", "pyType": "recovery", "pyBaseMatches": true, "pyTokensInQuery": false,
      "appRecoveryParse": "INVALID_LINK"
    },
    {
      "id": "signup-provider-error",
      "why": "An expired, used or wrong signup link: the provider redirects with an error in the fragment and no token.",
      "url": "uskociapp://auth?form=login#error=access_denied&error_code=otp_expired&error_description=Email+link+is+invalid+or+has+expired",
      "expectedBase": "signup",
      "pyKind": "PROVIDER_ERROR", "pyType": null, "pyBaseMatches": true, "pyTokensInQuery": false,
      "appRecoveryParse": "INVALID_LINK"
    },
    {
      "id": "recovery-provider-error",
      "why": "An expired, used or wrong recovery link.",
      "url": "uskociapp://oporavak#error=access_denied&error_code=otp_expired&error_description=Email+link+is+invalid+or+has+expired",
      "expectedBase": "recovery",
      "pyKind": "PROVIDER_ERROR", "pyType": null, "pyBaseMatches": true, "pyTokensInQuery": false,
      "appRecoveryParse": "INVALID_LINK"
    },
    {
      "id": "recovery-no-fragment",
      "why": "The bare destination carries no credential.",
      "url": "uskociapp://oporavak",
      "expectedBase": "recovery",
      "pyKind": "NO_FRAGMENT", "pyType": null, "pyBaseMatches": true, "pyTokensInQuery": false,
      "appRecoveryParse": "INVALID_LINK"
    },
    {
      "id": "recovery-tokens-in-query",
      "why": "Tokens in the QUERY (the PKCE or a hostile form) are not the implicit-flow fragment: refused, and the proof flags them.",
      "url": "uskociapp://oporavak?access_token=SYNTHACCESSQUERY00001&refresh_token=SYNTHREFRESHQUERY001&type=recovery",
      "expectedBase": "recovery",
      "pyKind": "NO_FRAGMENT", "pyType": null, "pyBaseMatches": false, "pyTokensInQuery": true,
      "appRecoveryParse": "INVALID_LINK"
    },
    {
      "id": "recovery-duplicate-keys",
      "why": "A fragment that repeats a key is ambiguous: refused.",
      "url": "uskociapp://oporavak#access_token=SYNTHACCESSDUP000001&access_token=SYNTHACCESSDUP000002&refresh_token=SYNTHREFRESHDUP00001&type=recovery",
      "expectedBase": "recovery",
      "pyKind": "MALFORMED", "pyType": "recovery", "pyBaseMatches": true, "pyTokensInQuery": false,
      "appRecoveryParse": "INVALID_LINK"
    },
    {
      "id": "recovery-missing-refresh-token",
      "why": "Half a session is not a session.",
      "url": "uskociapp://oporavak#access_token=SYNTHACCESSHALF00001&type=recovery",
      "expectedBase": "recovery",
      "pyKind": "MALFORMED", "pyType": "recovery", "pyBaseMatches": true, "pyTokensInQuery": false,
      "appRecoveryParse": "INVALID_LINK"
    }
  ]
}
